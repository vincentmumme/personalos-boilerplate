{
  "$id": "https://personal-os.local/schemas/pos-v1/skill.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed-tools": {
      "minLength": 1,
      "type": "string"
    },
    "description": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^<>]+$",
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "pos_writes_profile_keys"
            ]
          },
          "then": {
            "required": [
              "pos_check_refs"
            ]
          }
        }
      ],
      "patternProperties": {
        "^(?!pos_).+$": {}
      },
      "properties": {
        "pos_check_refs": {
          "items": {
            "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "pos_created": {
          "format": "date",
          "type": "string"
        },
        "pos_decision_refs": {
          "items": {
            "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "pos_derived_from_refs": {
          "items": {
            "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "pos_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "pos_invokes_skill_refs": {
          "items": {
            "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "pos_lifecycle": {
          "enum": [
            "active",
            "deprecated",
            "retired"
          ],
          "type": "string"
        },
        "pos_reads_profile_keys": {
