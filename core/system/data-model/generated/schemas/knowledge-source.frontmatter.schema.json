{
  "$id": "https://personal-os.local/schemas/pos-v1/knowledge-source.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captured_on": {
      "format": "date",
      "type": "string"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "immutable": {
      "const": true
    },
    "knowledge_source_kind": {
      "enum": [
        "article",
        "paper",
        "repository",
        "note",
        "dataset",
        "video",
        "audio",
        "social",
        "manual",
        "conversation",
        "unknown"
      ],
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "active",
        "archived"
      ],
      "type": "string"
    },
    "related_topic_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "source_integrity": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "type": "string"
    },
    "source_locator": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "topic_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "type": {
      "const": "knowledge-source"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "captured_on",
    "immutable",
    "knowledge_source_kind",
    "lifecycle",
    "source_integrity",
    "source_locator",
    "topic_ref"
  ],
  "title": "PersonalOS pos-v1 knowledge-source frontmatter",
  "type": "object"
}
