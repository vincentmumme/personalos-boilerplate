{
  "$id": "https://personal-os.local/schemas/pos-v1/finance-payment-source-registry.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created": {
      "format": "date",
      "type": "string"
    },
    "external_authority_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "registry_state": {
      "enum": [
        "active",
        "retired"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "subject_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "finance-payment-source-registry"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "registry_state",
    "subject_ref"
  ],
  "title": "PersonalOS pos-v1 finance-payment-source-registry frontmatter",
  "type": "object"
}
