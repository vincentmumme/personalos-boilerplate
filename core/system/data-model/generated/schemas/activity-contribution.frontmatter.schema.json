{
  "$id": "https://personal-os.local/schemas/pos-v1/activity-contribution.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity_outcome": {
      "enum": [
        "changed",
        "completed",
        "decided",
        "verified",
        "observed",
        "partial",
        "failed"
      ],
      "type": "string"
    },
    "affected_owner_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "day_date": {
      "format": "date",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "producer_kind": {
      "enum": [
        "human",
        "agent",
        "automation",
        "external-system",
        "hybrid"
      ],
      "type": "string"
    },
    "producer_name": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "producer_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "runtime_name": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "timezone": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "activity-contribution"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "activity_outcome",
    "affected_owner_refs",
    "day_date",
    "occurred_at",
    "producer_kind",
    "producer_name",
    "recorded_at",
    "timezone"
  ],
  "title": "PersonalOS pos-v1 activity-contribution frontmatter",
  "type": "object"
}
