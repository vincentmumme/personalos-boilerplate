{
  "$id": "https://personal-os.local/schemas/pos-v1/finance-expense.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount_gross": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "amount_net": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "booking_state": {
      "enum": [
        "received",
        "pending-review",
        "pending-booking",
        "booked",
        "rejected",
        "cancelled"
      ],
      "type": "string"
    },
    "company_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "currency": {
      "minLength": 1,
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "expense_date": {
      "format": "date",
      "type": "string"
    },
    "external_authority_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "external_record_id": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "finance_scope": {
      "enum": [
        "personal",
        "business",
        "mixed"
      ],
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "payment_state": {
      "enum": [
        "unknown",
        "open",
        "paid",
        "recipient-confirmed"
      ],
      "type": "string"
    },
    "project_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "source_amount": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "tax_rate": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "finance-expense"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "booking_state",
    "expense_date",
    "finance_scope"
  ],
  "title": "PersonalOS pos-v1 finance-expense frontmatter",
  "type": "object"
}
