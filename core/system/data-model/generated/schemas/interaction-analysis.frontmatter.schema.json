{
  "$id": "https://personal-os.local/schemas/pos-v1/interaction-analysis.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_owner_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "analysis_kind": {
      "enum": [
        "semantic",
        "research",
        "combined"
      ],
      "type": "string"
    },
    "analysis_outcome": {
      "enum": [
        "propagated",
        "no-op",
        "partial",
        "blocked"
      ],
      "type": "string"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "interaction_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "interaction-analysis"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "affected_owner_refs",
    "analysis_kind",
    "analysis_outcome",
    "evidence_refs",
    "interaction_ref"
  ],
  "title": "PersonalOS pos-v1 interaction-analysis frontmatter",
  "type": "object"
}
