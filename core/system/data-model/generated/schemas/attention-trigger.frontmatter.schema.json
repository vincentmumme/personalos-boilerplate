{
  "$id": "https://personal-os.local/schemas/pos-v1/attention-trigger.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "trigger_kind": {
            "enum": [
              "event"
            ]
          }
        },
        "required": [
          "trigger_kind"
        ]
      },
      "then": {
        "required": [
          "trigger_ref"
        ]
      }
    }
  ],
  "properties": {
    "created": {
      "format": "date",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "scheduled",
        "due",
        "resolved",
        "cancelled"
      ],
      "type": "string"
    },
    "review_at": {
      "format": "date",
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "trigger_kind": {
      "enum": [
        "date",
        "event"
      ],
      "type": "string"
    },
    "trigger_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "type": {
      "const": "attention-trigger"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "evidence_refs",
    "lifecycle",
    "review_at",
    "trigger_kind"
  ],
  "title": "PersonalOS pos-v1 attention-trigger frontmatter",
  "type": "object"
}
