{
  "$id": "https://personal-os.local/schemas/pos-v1/agent.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_kind": {
      "enum": [
        "general",
        "orchestrator",
        "specialist",
        "adapter"
      ],
      "type": "string"
    },
    "agent_scope": {
      "enum": [
        "personalos",
        "domain",
        "project",
        "runtime"
      ],
      "type": "string"
    },
    "authority_scope": {
      "enum": [
        "full",
        "personal-context",
        "pointer"
      ],
      "type": "string"
    },
    "canonical_system_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "planned",
        "active",
        "paused",
        "retired"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "agent"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "agent_kind",
    "agent_scope",
    "authority_scope",
    "canonical_system_ref",
    "lifecycle"
  ],
  "title": "PersonalOS pos-v1 agent frontmatter",
  "type": "object"
}
