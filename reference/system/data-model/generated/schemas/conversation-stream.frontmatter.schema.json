{
  "$id": "https://personal-os.local/schemas/pos-v1/conversation-stream.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage_ended_at": {
      "format": "date-time",
      "type": "string"
    },
    "coverage_started_at": {
      "format": "date-time",
      "type": "string"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "last_material_at": {
      "format": "date-time",
      "type": "string"
    },
    "participant_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "source_channel": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "stream_state": {
      "enum": [
        "active",
        "dormant",
        "closed"
      ],
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "conversation-stream"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "participant_refs",
    "source_channel",
    "stream_state"
  ],
  "title": "PersonalOS pos-v1 conversation-stream frontmatter",
  "type": "object"
}
