{
  "$id": "https://personal-os.local/schemas/pos-v1/view-record.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_scope": {
      "enum": [
        "full",
        "personal-context",
        "pointer"
      ],
      "type": "string"
    },
    "canonical_system_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "derivation_mode": {
      "enum": [
        "manual",
        "generated",
        "query",
        "hybrid"
      ],
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "active",
        "paused",
        "retired"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "source_owner_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "view-record"
    },
    "updated": {
      "format": "date",
      "type": "string"
    },
    "view_kind": {
      "enum": [
        "table",
        "dashboard",
        "report",
        "inventory",
        "navigation"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "authority_scope",
    "canonical_system_ref",
    "derivation_mode",
    "lifecycle",
    "source_owner_refs",
    "view_kind"
  ],
  "title": "PersonalOS pos-v1 view-record frontmatter",
  "type": "object"
}
