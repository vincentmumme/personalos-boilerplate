{
  "$id": "https://personal-os.local/schemas/pos-v1/content-evidence.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collection_state": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "content_evidence_kind": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "content_observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "content_tags": {
      "items": {
        "minLength": 1,
        "pattern": "^[^\\n]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "evidence_state": {
      "enum": [
        "captured",
        "normalized",
        "reviewed",
        "rejected"
      ],
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "origin_operation_id": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "piece_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "provenance_key": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "publication_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "content-evidence"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "collection_state",
    "content_evidence_kind",
    "content_observed_at",
    "evidence_state",
    "piece_ref",
    "provenance_key",
    "revision"
  ],
  "title": "PersonalOS pos-v1 content-evidence frontmatter",
  "type": "object"
}
