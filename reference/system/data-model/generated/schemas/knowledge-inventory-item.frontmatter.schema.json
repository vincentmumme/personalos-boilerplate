{
  "$id": "https://personal-os.local/schemas/pos-v1/knowledge-inventory-item.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created": {
      "format": "date",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "inventory_kind": {
      "enum": [
        "item",
        "candidate",
        "entity",
        "corpus",
        "question",
        "watch"
      ],
      "type": "string"
    },
    "inventory_state": {
      "enum": [
        "proposed",
        "accepted",
        "blocked",
        "parked",
        "rejected",
        "superseded"
      ],
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "active",
        "closed",
        "archived"
      ],
      "type": "string"
    },
    "related_topic_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "source_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "topic_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "type": {
      "const": "knowledge-inventory-item"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "inventory_kind",
    "inventory_state",
    "lifecycle",
    "topic_ref"
  ],
  "title": "PersonalOS pos-v1 knowledge-inventory-item frontmatter",
  "type": "object"
}
