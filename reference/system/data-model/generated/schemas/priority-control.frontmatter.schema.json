{
  "$id": "https://personal-os.local/schemas/pos-v1/priority-control.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "enum": [
              "active"
            ]
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "required": [
          "priority_control_expires_on"
        ]
      }
    }
  ],
  "properties": {
    "created": {
      "format": "date",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "active",
        "inactive"
      ],
      "type": "string"
    },
    "priority_control_expires_on": {
      "format": "date",
      "type": "string"
    },
    "priority_control_review_on": {
      "format": "date",
      "type": "string"
    },
    "priority_excluded_action_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "priority_focus_action_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "priority_focus_areas": {
      "items": {
        "minLength": 1,
        "pattern": "^[^\\n]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "priority_ordered_action_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "priority-control"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "lifecycle",
    "priority_control_review_on"
  ],
  "title": "PersonalOS pos-v1 priority-control frontmatter",
  "type": "object"
}
