        "content-production-spec",
        "content-publication",
        "content-research",
        "content-series",
        "content-source",
        "content-tracking-link",
        "content-version",
        "context-gap-review",
        "contract",
        "convention",
        "conversation-stream",
        "customer-profile",
        "daily-briefing",
        "data-model-changelog",
        "data-model-document",
        "day-record",
        "decision",
        "finance-account",
        "finance-client-cost",
        "finance-expense",
        "finance-invoice",
        "finance-payment-source-registry",
        "finance-recurring-obligation",
        "finance-tax-dossier",
        "finance-tax-manifest",
        "finance-time-entry",
        "framework",
        "health-daily-assessment",
        "health-measurement",
        "health-operating-model",
        "health-plan",
        "health-profile",
        "health-provider-snapshot",
        "host",
        "idea",
        "identity-biography",
        "identity-capabilities",
        "identity-legal",
        "identity-life-orientation",
        "identity-operating-profile",
        "identity-personal-constitution",
        "identity-record",
