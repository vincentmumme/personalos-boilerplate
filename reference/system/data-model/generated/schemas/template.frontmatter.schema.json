  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "decision_refs",
    "lifecycle",
    "system_refs",
    "target_profile_key"
  ],
  "title": "PersonalOS pos-v1 template frontmatter",
  "type": "object"
}
