        "content-configuration",
        "content-context-pack",
        "content-evidence",
        "content-format",
        "content-guide",
        "content-idea",
        "content-input",
        "content-knowledge-candidate",
        "content-learning-candidate",
        "content-piece",
        "content-production-job",
