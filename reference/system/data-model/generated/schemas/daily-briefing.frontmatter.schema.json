{
  "$id": "https://personal-os.local/schemas/pos-v1/daily-briefing.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "briefing_kind": {
      "enum": [
        "morning",
        "midday",
        "evening",
        "ad-hoc"
      ],
      "type": "string"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "day_date": {
      "format": "date",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "producer_skill_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "timezone": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "daily-briefing"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "briefing_kind",
    "day_date",
    "generated_at",
    "producer_skill_ref",
    "timezone"
  ],
  "title": "PersonalOS pos-v1 daily-briefing frontmatter",
  "type": "object"
}
