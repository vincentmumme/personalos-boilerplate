{
  "$id": "https://personal-os.local/schemas/pos-v1/finance-tax-manifest.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created": {
      "format": "date",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "manifest_state": {
      "enum": [
        "collecting",
        "complete",
        "sealed"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "tax_dossier_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "tax_year": {
      "minLength": 1,
      "pattern": "^[0-9]{4}$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "finance-tax-manifest"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "manifest_state",
    "tax_dossier_ref",
    "tax_year"
  ],
  "title": "PersonalOS pos-v1 finance-tax-manifest frontmatter",
  "type": "object"
}
