{
  "$id": "https://personal-os.local/schemas/pos-v1/capture.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "enum": [
              "processed"
            ]
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "required": [
          "processing_outcome",
          "retention_disposition"
        ]
      }
    }
  ],
  "properties": {
    "created": {
      "format": "date",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "input_kind": {
      "enum": [
        "chat",
        "voice-note",
        "handwritten",
        "screenshot",
        "file",
        "url",
        "manual",
        "other"
      ],
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "unprocessed",
        "staged",
        "processed"
      ],
      "type": "string"
    },
    "processing_outcome": {
      "enum": [
        "no-op",
        "routed",
        "promoted"
      ],
      "type": "string"
    },
    "retention_disposition": {
      "enum": [
        "raw-retained",
        "redacted",
        "stable-pointer",
        "compacted",
        "discarded"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "capture"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "input_kind",
    "lifecycle"
  ],
  "title": "PersonalOS pos-v1 capture frontmatter",
  "type": "object"
}
