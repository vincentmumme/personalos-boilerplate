{
  "$id": "https://personal-os.local/schemas/pos-v1/knowledge-assessment.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessment_kind": {
      "enum": [
        "quality",
        "freshness",
        "coherence",
        "schema",
        "migration",
        "research"
      ],
      "type": "string"
    },
    "assessment_outcome": {
      "enum": [
        "healthy",
        "findings",
        "partial",
        "blocked",
        "historical"
      ],
      "type": "string"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "active",
        "superseded",
        "archived"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "source_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "topic_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "type": {
      "const": "knowledge-assessment"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "assessment_kind",
    "assessment_outcome",
    "lifecycle",
    "topic_ref"
  ],
  "title": "PersonalOS pos-v1 knowledge-assessment frontmatter",
  "type": "object"
}
