{
  "$id": "https://personal-os.local/schemas/pos-v1/action-candidate.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created": {
      "format": "date",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "pending",
        "promoted-to-action",
        "promoted-to-trigger",
        "merged",
        "discarded",
        "needs-clarification"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "triage_by": {
      "format": "date",
      "type": "string"
    },
    "type": {
      "const": "action-candidate"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "evidence_refs",
    "lifecycle"
  ],
  "title": "PersonalOS pos-v1 action-candidate frontmatter",
  "type": "object"
}
