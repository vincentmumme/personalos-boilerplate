{
  "$id": "https://personal-os.local/schemas/pos-v1/content-learning-candidate.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_state": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded"
      ],
      "type": "string"
    },
    "content_evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "content_tags": {
      "items": {
        "minLength": 1,
        "pattern": "^[^\\n]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "hypothesis_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[^\\n]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "observation_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[^\\n]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "origin_operation_id": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "target_owner_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "content-learning-candidate"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "candidate_state",
    "revision"
  ],
  "title": "PersonalOS pos-v1 content-learning-candidate frontmatter",
  "type": "object"
}
