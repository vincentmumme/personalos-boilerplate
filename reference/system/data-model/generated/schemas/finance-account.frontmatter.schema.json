{
  "$id": "https://personal-os.local/schemas/pos-v1/finance-account.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_number": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "account_state": {
      "enum": [
        "active",
        "closed",
        "unknown"
      ],
      "type": "string"
    },
    "bic": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "company_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "external_authority_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "finance_scope": {
      "enum": [
        "personal",
        "business",
        "mixed"
      ],
      "type": "string"
    },
    "iban": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "institution": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "payment_source_registry_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "secure_locator": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "subject_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "finance-account"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "account_state",
    "finance_scope",
    "institution",
    "subject_ref"
  ],
  "title": "PersonalOS pos-v1 finance-account frontmatter",
  "type": "object"
}
