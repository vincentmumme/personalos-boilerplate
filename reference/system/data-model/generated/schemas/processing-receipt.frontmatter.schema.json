{
  "$id": "https://personal-os.local/schemas/pos-v1/processing-receipt.frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_owner_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "interaction_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "processed_at": {
      "format": "date-time",
      "type": "string"
    },
    "producer_skill_ref": {
      "pattern": "^\\[\\[[^\\]\\n]+\\]\\]$",
      "type": "string"
    },
    "receipt_kind": {
      "enum": [
        "source-ingest",
        "semantic-propagation",
        "reconciliation"
      ],
      "type": "string"
    },
    "receipt_outcome": {
      "enum": [
        "propagated",
        "partial",
        "blocked"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "pos-v1"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]+$",
      "type": "string"
    },
    "type": {
      "const": "processing-receipt"
    },
    "updated": {
      "format": "date",
      "type": "string"
    },
    "verification_result": {
      "enum": [
        "pass",
        "warn",
        "blocked"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "created",
    "updated",
    "affected_owner_refs",
    "evidence_refs",
    "interaction_ref",
    "processed_at",
    "producer_skill_ref",
    "receipt_kind",
    "receipt_outcome",
    "verification_result"
  ],
  "title": "PersonalOS pos-v1 processing-receipt frontmatter",
  "type": "object"
}
